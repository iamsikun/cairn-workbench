{
  "$defs": {
    "DeviceProbe": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "gpu": {
          "title": "Gpu",
          "type": "string"
        },
        "host_canary_preserved": {
          "const": true,
          "title": "Host Canary Preserved",
          "type": "boolean"
        },
        "image": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "model_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Hash",
          "type": "string"
        },
        "nonce": {
          "title": "Nonce",
          "type": "string"
        },
        "projection_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Projection Hash",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/ProbeResult"
        }
      },
      "required": [
        "nonce",
        "image",
        "model_hash",
        "projection_hash",
        "result",
        "host_canary_preserved",
        "gpu",
        "at"
      ],
      "title": "DeviceProbe",
      "type": "object"
    },
    "ProbeResult": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Checks",
          "type": "object"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Nonce",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "nonce",
        "checks"
      ],
      "title": "ProbeResult",
      "type": "object"
    },
    "QualityReview": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "image": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "model_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Hash",
          "type": "string"
        },
        "owner_statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Owner Statement",
          "type": "string"
        },
        "peak_vram_mib": {
          "maximum": 24000,
          "minimum": 1,
          "title": "Peak Vram Mib",
          "type": "integer"
        },
        "projection_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Projection Hash",
          "type": "string"
        },
        "trial_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trial Hash",
          "type": "string"
        }
      },
      "required": [
        "trial_hash",
        "model_hash",
        "projection_hash",
        "image",
        "peak_vram_mib",
        "owner_statement",
        "at"
      ],
      "title": "QualityReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command": {
      "default": "posix",
      "enum": [
        "posix",
        "windows_wsl"
      ],
      "title": "Command",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "image": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image",
      "type": "string"
    },
    "known_hosts": {
      "title": "Known Hosts",
      "type": "string"
    },
    "known_hosts_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Known Hosts Hash",
      "type": "string"
    },
    "model_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Hash",
      "type": "string"
    },
    "model_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Model Revision",
      "type": "string"
    },
    "probe": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceProbe"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "projection_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Projection Hash",
      "type": "string"
    },
    "quality_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualityReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Runtime Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "default": "research",
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Scope",
      "type": "string"
    },
    "ssh_alias": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$",
      "title": "Ssh Alias",
      "type": "string"
    }
  },
  "required": [
    "id",
    "ssh_alias",
    "known_hosts",
    "known_hosts_hash",
    "image",
    "model_hash",
    "projection_hash",
    "model_revision",
    "runtime_revision"
  ],
  "title": "DeviceConfig",
  "type": "object"
}
