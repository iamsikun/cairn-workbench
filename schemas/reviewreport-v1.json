{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "amounts": {
          "items": {
            "$ref": "#/$defs/Money"
          },
          "title": "Amounts",
          "type": "array"
        },
        "context_role": {
          "anyOf": [
            {
              "enum": [
                "tried",
                "relevant_literature",
                "failed_approaches",
                "open_issues",
                "next_action"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Role"
        },
        "disputes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Disputes",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "reported_result",
            "inference",
            "hypothesis",
            "owner_decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "supersedes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verification": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "reviewed",
            "disputed",
            "superseded"
          ],
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "kind"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_hash",
        "evidence_hash",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "account_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Alias"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "owner_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Alias"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit",
        "as_of",
        "sources"
      ],
      "title": "Money",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "account_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Alias"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "owner_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Alias"
        },
        "statement_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement Period"
        },
        "tax_year": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax Year"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "title": "Period",
      "type": "object"
    },
    "ReviewChange": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "title": "Assertions",
          "type": "array"
        },
        "base_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Hash"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "current_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Hash"
        },
        "diff": {
          "title": "Diff",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proposed Hash",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "target",
        "base_hash",
        "current_hash",
        "proposed_hash",
        "rationale",
        "period",
        "conflicts",
        "diff"
      ],
      "title": "ReviewChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "$ref": "#/$defs/ReviewChange"
      },
      "title": "Changes",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Hash",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "References",
      "type": "array"
    },
    "review_flags": {
      "items": {
        "type": "string"
      },
      "title": "Review Flags",
      "type": "array"
    },
    "route": {
      "title": "Route",
      "type": "string"
    },
    "scope": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Scope",
      "type": "string"
    },
    "stage": {
      "default": "proposed",
      "title": "Stage",
      "type": "string"
    },
    "validation": {
      "title": "Validation",
      "type": "string"
    }
  },
  "required": [
    "id",
    "proposal_hash",
    "provider",
    "route",
    "scope",
    "validation",
    "review_flags",
    "changes",
    "references"
  ],
  "title": "ReviewReport",
  "type": "object"
}
