{
  "additionalProperties": false,
  "description": "Owner-side record that an agent's draft for one packet was staged and validated.",
  "properties": {
    "job_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Job Id",
      "type": "string"
    },
    "processing_verified": {
      "const": false,
      "default": false,
      "title": "Processing Verified",
      "type": "boolean"
    },
    "proposal_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Proposal Id"
    },
    "response_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Hash",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workflow_stage": {
      "enum": [
        "validated",
        "unchanged"
      ],
      "title": "Workflow Stage",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "response_hash",
    "proposal_id",
    "workflow_stage"
  ],
  "title": "DraftReceipt",
  "type": "object"
}
