{
  "$defs": {
    "ObservedValue": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "measure": {
          "enum": [
            "balance",
            "holding_quantity",
            "price",
            "transaction",
            "other"
          ],
          "title": "Measure",
          "type": "string"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,18}|(?=[\\d.]{1,31}0*$)\\d{0,18}\\.\\d{0,12}0*$)",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "label",
        "measure",
        "value",
        "unit"
      ],
      "title": "ObservedValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_alias": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Account Alias",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "owner_alias": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Owner Alias",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "statement_period": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Statement Period"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/ObservedValue"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "owner_alias",
    "account_alias",
    "as_of",
    "values"
  ],
  "title": "FinancialSnapshot",
  "type": "object"
}
