      "title": "Image",
      "type": "string"
    },
    "profile_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Hash",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/ProbeResult"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "at",
    "image",
    "profile_hash",
    "result"
  ],
  "title": "WorkerProfile",
  "type": "object"
