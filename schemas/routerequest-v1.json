{
  "$defs": {
    "Labels": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "default": "private",
          "enum": [
            "public",
            "private",
            "restricted"
          ],
          "title": "Classification",
          "type": "string"
        },
        "compartments": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Compartments",
          "type": "array",
          "uniqueItems": true
        },
        "domain": {
          "enum": [
            "research",
            "finance",
            "life",
            "shared"
          ],
          "title": "Domain",
          "type": "string"
        },
        "processing": {
          "default": "local_only",
          "enum": [
            "local_only",
            "cloud_eligible"
          ],
          "title": "Processing",
          "type": "string"
        }
      },
      "required": [
        "domain"
      ],
      "title": "Labels",
      "type": "object"
    },
    "RequestPart": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 200000,
          "title": "Content",
          "type": "string"
        },
        "labels": {
          "anyOf": [
            {
              "$ref": "#/$defs/Labels"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "enum": [
            "instructions",
            "derived_metadata",
            "output_handling",
            "traces"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "RequestPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "destination": {
      "default": "local",
      "title": "Destination",
      "type": "string"
    },
    "operation": {
      "enum": [
        "generation",
        "extraction",
        "query",
        "context",
        "client_export"
      ],
      "title": "Operation",
      "type": "string"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/RequestPart"
      },
      "maxItems": 20,
      "title": "Parts",
      "type": "array"
    },
    "provider": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "question": {
      "maxLength": 20000,
      "title": "Question",
      "type": "string"
    },
    "question_labels": {
      "anyOf": [
        {
          "$ref": "#/$defs/Labels"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "record_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Record Ids",
      "type": "array"
    },
    "route": {
      "enum": [
        "local",
        "cloud"
      ],
      "title": "Route",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "route",
    "provider",
    "operation",
    "question"
  ],
  "title": "RouteRequest",
  "type": "object"
}
