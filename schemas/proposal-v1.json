{
  "$defs": {
    "Change": {
      "additionalProperties": false,
      "properties": {
        "base_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Hash"
        },
        "content": {
          "maxLength": 1000000,
          "title": "Content",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "diff": {
          "title": "Diff",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "base_hash",
        "content",
        "content_hash",
        "diff",
        "rationale"
      ],
      "title": "Change",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Changes",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Job Id",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "review_flags": {
      "items": {
        "type": "string"
      },
      "title": "Review Flags",
      "type": "array",
      "uniqueItems": true
    },
    "route": {
      "enum": [
        "local",
        "cloud"
      ],
      "title": "Route",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workspace_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "job_id",
    "input_hash",
    "policy_hash",
    "provider",
    "route",
    "created_at",
    "changes"
  ],
  "title": "Proposal",
  "type": "object"
}
