{
  "$defs": {
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "title": "Coverage",
          "type": "string"
        },
        "images_inspected": {
          "title": "Images Inspected",
          "type": "boolean"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Key",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "source_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Date"
        },
        "support": {
          "default": "Hash and locator checked; quote presence does not establish entailment.",
          "title": "Support",
          "type": "string"
        },
        "tables_inspected": {
          "title": "Tables Inspected",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "key",
        "reference",
        "title",
        "text",
        "coverage",
        "tables_inspected",
        "images_inspected"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_hash",
        "evidence_hash",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ViewAsset": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "maxLength": 7000000,
          "title": "Data",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "mime": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Mime",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mime",
        "data",
        "sha256"
      ],
      "title": "ViewAsset",
      "type": "object"
    },
    "ViewBlock": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor"
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "citations": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "kind": {
          "default": "text",
          "enum": [
            "text",
            "quote",
            "code",
            "diagram",
            "markdown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "ViewBlock",
      "type": "object"
    },
    "ViewDocument": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/ViewAsset"
          },
          "maxItems": 8,
          "title": "Assets",
          "type": "array"
        },
        "bundle_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Hash",
          "type": "string"
        },
        "bundle_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "feedback": {
          "default": false,
          "title": "Feedback",
          "type": "boolean"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/ViewSection"
          },
          "title": "Sections",
          "type": "array"
        },
        "subtitle": {
          "title": "Subtitle",
          "type": "string"
        },
        "targets": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Targets",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "title",
        "bundle_id",
        "bundle_hash",
        "subtitle",
        "sections",
        "evidence",
        "targets"
      ],
      "title": "ViewDocument",
      "type": "object"
    },
    "ViewSection": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/ViewBlock"
          },
          "title": "Blocks",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "blocks"
      ],
      "title": "ViewSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document": {
      "$ref": "#/$defs/ViewDocument"
    },
    "operation": {
      "const": "render_view",
      "default": "render_view",
      "title": "Operation",
      "type": "string"
    }
  },
  "required": [
    "document"
  ],
  "title": "RenderJob",
  "type": "object"
}
