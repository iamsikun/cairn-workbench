{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "amounts": {
          "items": {
            "$ref": "#/$defs/Money"
          },
          "title": "Amounts",
          "type": "array"
        },
        "context_role": {
          "anyOf": [
            {
              "enum": [
                "tried",
                "relevant_literature",
                "failed_approaches",
                "open_issues",
                "next_action"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Role"
        },
        "disputes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Disputes",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "reported_result",
            "inference",
            "hypothesis",
            "owner_decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "supersedes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verification": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "reviewed",
            "disputed",
            "superseded"
          ],
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "kind"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_hash",
        "evidence_hash",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Extraction": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "enum": [
            "full_text",
            "excerpt",
            "abstract_only",
            "failed"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "images_inspected": {
          "default": false,
          "title": "Images Inspected",
          "type": "boolean"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "normalization": {
          "const": "none",
          "default": "none",
          "title": "Normalization",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "title": "Segments",
          "type": "array"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Source Id",
          "type": "string"
        },
        "tables_inspected": {
          "default": false,
          "title": "Tables Inspected",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "source_hash",
        "method",
        "method_version",
        "coverage",
        "segments"
      ],
      "title": "Extraction",
      "type": "object"
    },
    "ExtractionMetadata": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "enum": [
            "full_text",
            "excerpt",
            "abstract_only",
            "failed"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "images_inspected": {
          "default": false,
          "title": "Images Inspected",
          "type": "boolean"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "tables_inspected": {
          "default": false,
          "title": "Tables Inspected",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_hash",
        "method",
        "method_version",
        "coverage"
      ],
      "title": "ExtractionMetadata",
      "type": "object"
    },
    "JsonValue": {},
    "Money": {
      "additionalProperties": false,
      "properties": {
        "account_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Alias"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "owner_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Alias"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit",
        "as_of",
        "sources"
      ],
      "title": "Money",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 200000,
          "title": "Body",
          "type": "string"
        },
        "record": {
          "$ref": "#/$defs/Record"
        }
      },
      "required": [
        "record",
        "body"
      ],
      "title": "Page",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "account_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Alias"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "owner_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Alias"
        },
        "statement_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement Period"
        },
        "tax_year": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax Year"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "title": "Period",
      "type": "object"
    },
    "Record": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "title": "Assertions",
          "type": "array"
        },
        "classification": {
          "default": "private",
          "enum": [
            "public",
            "private",
            "restricted"
          ],
          "title": "Classification",
          "type": "string"
        },
        "compartments": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Compartments",
          "type": "array",
          "uniqueItems": true
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "domain": {
          "enum": [
            "research",
            "finance",
            "life",
            "shared"
          ],
          "title": "Domain",
          "type": "string"
        },
        "finance_category": {
          "anyOf": [
            {
              "enum": [
                "educational",
                "official_rule",
                "account_snapshot",
                "owner_decision"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finance Category"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "processing": {
          "default": "local_only",
          "enum": [
            "local_only",
            "cloud_eligible"
          ],
          "title": "Processing",
          "type": "string"
        },
        "project_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Project Ids",
          "type": "array"
        },
        "related": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Related",
          "type": "array"
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepositoryBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Date"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sections": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Sections",
          "type": "object"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "active",
            "disputed",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "enum": [
            "source",
            "concept",
            "project",
            "decision",
            "entity",
            "playbook"
          ],
          "title": "Type",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "id",
        "type",
        "title",
        "created_at",
        "updated_at"
      ],
      "title": "Record",
      "type": "object"
    },
    "RepositoryBinding": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Alias",
          "type": "string"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Commit",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "worktree_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Worktree Hash",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "commit",
        "worktree_hash"
      ],
      "title": "RepositoryBinding",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "system",
                "developer",
                "user",
                "assistant",
                "tool"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "text"
      ],
      "title": "Segment",
      "type": "object"
    },
    "SourceMetadata": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "bibliography": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bibliography"
        },
        "blob": {
          "title": "Blob",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "citation_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Key"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identity": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Identity",
          "type": "string"
        },
        "library_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Library Alias"
        },
        "origin": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "source_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Date"
        },
        "source_type": {
          "enum": [
            "text",
            "markdown",
            "pdf",
            "conversation",
            "bibliography",
            "receipt",
            "finance_snapshot",
            "life_dossier"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "supersedes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "identity",
        "origin",
        "source_type",
        "captured_at",
        "content_hash",
        "blob"
      ],
      "title": "SourceMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Hash",
      "type": "string"
    },
    "execution_image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Image"
    },
    "extraction": {
      "$ref": "#/$defs/Extraction"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "max_changes": {
      "default": 4,
      "maximum": 20,
      "minimum": 1,
      "title": "Max Changes",
      "type": "integer"
    },
    "operation": {
      "const": "ingest",
      "default": "ingest",
      "title": "Operation",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "related": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "maxItems": 20,
      "title": "Related",
      "type": "array"
    },
    "route": {
      "default": "local",
      "enum": [
        "local",
        "cloud",
        "owner_device"
      ],
      "title": "Route",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_name": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Scope Name",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Record"
    }
  },
  "required": [
    "id",
    "policy_hash",
    "scope_name",
    "provider",
    "source",
    "extraction",
    "evidence_hash"
  ],
  "title": "Job",
  "type": "object"
}
