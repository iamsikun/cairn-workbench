{
  "$defs": {
    "PageClaim": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "reported_result",
            "inference",
            "hypothesis"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceCitation"
          },
          "maxItems": 40,
          "title": "Sources",
          "type": "array"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "title": "PageClaim",
      "type": "object"
    },
    "SourceCitation": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator"
      ],
      "title": "SourceCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the owner's agent returns for a page; Cairn binds and formats it.",
  "properties": {
    "aliases": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aliases"
    },
    "body_markdown": {
      "maxLength": 200000,
      "minLength": 1,
      "title": "Body Markdown",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/PageClaim"
      },
      "maxItems": 100,
      "title": "Claims",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 40,
      "title": "Limitations",
      "type": "array"
    },
    "project_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Ids"
    },
    "related": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    }
  },
  "required": [
    "body_markdown"
  ],
  "title": "PageAnswer",
  "type": "object"
}
