        "type": "string"
      },
      "minItems": 1,
      "title": "Operations",
      "type": "array",
      "uniqueItems": true
    },
    "owner_consent": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Owner Consent",
      "type": "string"
    },
    "provider": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "scope": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Scope",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    }
