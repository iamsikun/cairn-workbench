{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_hash",
        "evidence_hash",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "account_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Alias"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "owner_alias": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Alias"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit",
        "as_of",
        "sources"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "decimal-v1",
      "default": "decimal-v1",
      "title": "Algorithm",
      "type": "string"
    },
    "operands": {
      "items": {
        "$ref": "#/$defs/Money"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Operands",
      "type": "array"
    },
    "operation": {
      "enum": [
        "sum",
        "difference"
      ],
      "title": "Operation",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/Money"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "operation",
    "operands",
    "result"
  ],
  "title": "Calculation",
  "type": "object"
}
