{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_hash",
        "evidence_hash",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "LifeEvent": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "description": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "date",
        "description",
        "sources"
      ],
      "title": "LifeEvent",
      "type": "object"
    },
    "LifeTerm": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "description": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "warranty",
            "renewal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "date",
        "description",
        "sources"
      ],
      "title": "LifeTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authoritative_documents": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Authoritative Documents",
      "type": "array"
    },
    "entity_alias": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Entity Alias",
      "type": "string"
    },
    "entity_kind": {
      "enum": [
        "home",
        "vehicle",
        "pet",
        "device",
        "other"
      ],
      "title": "Entity Kind",
      "type": "string"
    },
    "procedures": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 100,
      "title": "Procedures",
      "type": "array"
    },
    "review_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Date"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "service_history": {
      "items": {
        "$ref": "#/$defs/LifeEvent"
      },
      "maxItems": 1000,
      "title": "Service History",
      "type": "array"
    },
    "terms": {
      "items": {
        "$ref": "#/$defs/LifeTerm"
      },
      "maxItems": 100,
      "title": "Terms",
      "type": "array"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "entity_alias",
    "entity_kind",
    "title",
    "authoritative_documents"
  ],
  "title": "LifeDossier",
  "type": "object"
}
