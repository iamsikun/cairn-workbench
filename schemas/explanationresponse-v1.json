{
  "$defs": {
    "ExplanationBlock": {
      "additionalProperties": false,
      "properties": {
        "evidence_keys": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "maxItems": 40,
          "title": "Evidence Keys",
          "type": "array"
        },
        "kind": {
          "enum": [
            "reported_result",
            "inference",
            "hypothesis",
            "question"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quotations": {
          "items": {
            "$ref": "#/$defs/Quotation"
          },
          "maxItems": 20,
          "title": "Quotations",
          "type": "array"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "title": "ExplanationBlock",
      "type": "object"
    },
    "Quotation": {
      "additionalProperties": false,
      "properties": {
        "evidence_key": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Evidence Key",
          "type": "string"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "evidence_key",
        "text"
      ],
      "title": "Quotation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/ExplanationBlock"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Job Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 40,
      "title": "Limitations",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "job_id",
    "input_hash",
    "blocks"
  ],
  "title": "ExplanationResponse",
  "type": "object"
}
