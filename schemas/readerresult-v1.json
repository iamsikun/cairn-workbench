{
  "$defs": {
    "Extraction": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "enum": [
            "full_text",
            "excerpt",
            "abstract_only",
            "failed"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "images_inspected": {
          "default": false,
          "title": "Images Inspected",
          "type": "boolean"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "normalization": {
          "const": "none",
          "default": "none",
          "title": "Normalization",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "title": "Segments",
          "type": "array"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Source Id",
          "type": "string"
        },
        "tables_inspected": {
          "default": false,
          "title": "Tables Inspected",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "source_hash",
        "method",
        "method_version",
        "coverage",
        "segments"
      ],
      "title": "Extraction",
      "type": "object"
    },
    "PaperClaim": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "reported_result",
          "enum": [
            "reported_result",
            "inference",
            "hypothesis"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "text": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "page"
      ],
      "title": "PaperClaim",
      "type": "object"
    },
    "PaperSummary": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/PaperClaim"
          },
          "maxItems": 20,
          "title": "Assumptions",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/PaperClaim"
          },
          "maxItems": 40,
          "title": "Findings",
          "type": "array"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/PaperClaim"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/PaperClaim"
          },
          "maxItems": 20,
          "title": "Methods",
          "type": "array"
        },
        "research_question": {
          "items": {
            "$ref": "#/$defs/PaperClaim"
          },
          "maxItems": 20,
          "title": "Research Question",
          "type": "array"
        },
        "summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "summary"
      ],
      "title": "PaperSummary",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "system",
                "developer",
                "user",
                "assistant",
                "tool"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "text"
      ],
      "title": "Segment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "extraction": {
      "$ref": "#/$defs/Extraction"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "inspected_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Inspected Pages",
      "type": "array"
    },
    "job_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Job Id",
      "type": "string"
    },
    "model_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Hash",
      "type": "string"
    },
    "page_count": {
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "summary": {
      "$ref": "#/$defs/PaperSummary"
    },
    "visual_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Visual Pages",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "input_hash",
    "model_hash",
    "extraction",
    "summary",
    "inspected_pages",
    "page_count"
  ],
  "title": "ReaderResult",
  "type": "object"
}
