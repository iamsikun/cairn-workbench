{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_hash",
        "evidence_hash",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "reported_result",
        "inference",
        "hypothesis"
      ],
      "title": "Kind",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 20,
      "title": "Sources",
      "type": "array"
    },
    "text": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "text",
    "kind"
  ],
  "title": "FinchClaim",
  "type": "object"
}
