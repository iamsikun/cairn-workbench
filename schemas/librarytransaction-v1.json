{
  "$defs": {
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "title": "After",
          "type": "string"
        },
        "after_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Hash",
          "type": "string"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "before_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Hash"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "before",
        "before_hash",
        "after",
        "after_hash"
      ],
      "title": "Entry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "title": "Entries",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "library",
      "default": "library",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "default": "prepared",
      "enum": [
        "prepared",
        "committed"
      ],
      "title": "Status",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "policy_hash",
    "operation",
    "at",
    "entries"
  ],
  "title": "LibraryTransaction",
  "type": "object"
}
