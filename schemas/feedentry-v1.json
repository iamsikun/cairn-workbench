{
  "$defs": {
    "FeedEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "new_publication",
            "newly_discovered",
            "box_addition",
            "box_revision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "paper_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Paper Id",
          "type": "string"
        },
        "reading_requested": {
          "default": false,
          "title": "Reading Requested",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "paper_id",
        "kind",
        "at"
      ],
      "title": "FeedEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_status": {
      "default": "not_started",
      "title": "Analysis Status",
      "type": "string"
    },
    "availability": {
      "title": "Availability",
      "type": "string"
    },
    "citation": {
      "title": "Citation",
      "type": "string"
    },
    "coverage": {
      "default": "Not read",
      "title": "Coverage",
      "type": "string"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "event": {
      "$ref": "#/$defs/FeedEvent"
    },
    "journal_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "title": "Journal Ids",
      "type": "array"
    },
    "journals": {
      "items": {
        "type": "string"
      },
      "title": "Journals",
      "type": "array"
    },
    "proposal_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Id"
    },
    "reading_status": {
      "default": "unknown",
      "title": "Reading Status",
      "type": "string"
    },
    "review_state": {
      "default": "unreviewed",
      "title": "Review State",
      "type": "string"
    },
    "source_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Hash"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "verification": {
      "items": {
        "type": "string"
      },
      "title": "Verification",
      "type": "array"
    }
  },
  "required": [
    "event",
    "title",
    "citation",
    "journal_ids",
    "journals",
    "availability"
  ],
  "title": "FeedEntry",
  "type": "object"
}
