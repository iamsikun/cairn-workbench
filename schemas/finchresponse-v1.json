{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_hash",
        "evidence_hash",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FinchClaim": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "reported_result",
            "inference",
            "hypothesis"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 20,
          "title": "Sources",
          "type": "array"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "title": "FinchClaim",
      "type": "object"
    },
    "ReceiptMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ReceiptMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/FinchClaim"
      },
      "maxItems": 100,
      "title": "Claims",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 40,
      "title": "Limitations",
      "type": "array"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ReceiptMessage"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Session Id",
      "type": "string"
    },
    "summary": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "unresolved": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "session_id",
    "input_hash",
    "summary",
    "messages"
  ],
  "title": "FinchResponse",
  "type": "object"
}
