{
  "$defs": {
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "cloud_grants": {
          "items": {
            "$ref": "#/$defs/RouteGrant"
          },
          "title": "Cloud Grants",
          "type": "array"
        },
        "last_change": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Change"
        },
        "max_changes": {
          "default": 4,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Changes",
          "type": "integer"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scopes": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{2,95}$": {
              "$ref": "#/$defs/Scope"
            }
          },
          "title": "Scopes",
          "type": "object"
        }
      },
      "required": [
        "scopes"
      ],
      "title": "Policy",
      "type": "object"
    },
    "RouteGrant": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "enum": [
              "generation",
              "extraction",
              "query",
              "context",
              "client_export"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array",
          "uniqueItems": true
        },
        "owner_consent": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Owner Consent",
          "type": "string"
        },
        "provider": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "scope": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Scope",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "provider",
        "destination",
        "operations",
        "valid_until",
        "owner_consent"
      ],
      "title": "RouteGrant",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "compartments": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Compartments",
          "type": "array",
          "uniqueItems": true
        },
        "domains": {
          "items": {
            "enum": [
              "research",
              "finance",
              "life",
              "shared"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Domains",
          "type": "array",
          "uniqueItems": true
        },
        "max_classification": {
          "default": "private",
          "enum": [
            "public",
            "private",
            "restricted"
          ],
          "title": "Max Classification",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Name",
          "type": "string"
        },
        "project_ids": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{2,95}$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Ids"
        },
        "record_ids": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{2,95}$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Ids"
        }
      },
      "required": [
        "name",
        "domains"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "after": {
      "$ref": "#/$defs/Policy"
    },
    "after_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "After Hash",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "before": {
      "$ref": "#/$defs/Policy"
    },
    "before_content": {
      "title": "Before Content",
      "type": "string"
    },
    "before_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Before Hash",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "operation": {
      "enum": [
        "set_scope",
        "set_grant",
        "revoke_grant"
      ],
      "title": "Operation",
      "type": "string"
    },
    "owner_statement": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Owner Statement",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workspace_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "at",
    "operation",
    "before_hash",
    "after_hash",
    "before_content",
    "before",
    "after",
    "owner_statement"
  ],
  "title": "PolicyChange",
  "type": "object"
}
