{
  "$defs": {
    "ReaderJob": {
      "additionalProperties": false,
      "properties": {
        "chunk_pages": {
          "default": 4,
          "maximum": 4,
          "minimum": 1,
          "title": "Chunk Pages",
          "type": "integer"
        },
        "device_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Device Hash",
          "type": "string"
        },
        "device_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Device Id",
          "type": "string"
        },
        "guidance_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guidance Hash"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "model_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Hash",
          "type": "string"
        },
        "page_limit": {
          "default": 500,
          "maximum": 2000,
          "minimum": 1,
          "title": "Page Limit",
          "type": "integer"
        },
        "paper_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Paper Id",
          "type": "string"
        },
        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "projection_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Projection Hash",
          "type": "string"
        },
        "prompt_version": {
          "default": "finch-paper-reader-v2",
          "enum": [
            "paper-reader-v1",
            "finch-paper-reader-v1",
            "finch-paper-reader-v2"
          ],
          "title": "Prompt Version",
          "type": "string"
        },
        "reading_revision": {
          "default": 1,
          "maximum": 10000,
          "minimum": 1,
          "title": "Reading Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "default": "research",
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Scope",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "pdf",
            "bibliography"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "paper_id",
        "source_id",
        "source_hash",
        "policy_hash",
        "device_hash",
        "device_id",
        "source_type",
        "title",
        "model_hash",
        "projection_hash"
      ],
      "title": "ReaderJob",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "attempts": {
      "default": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "job": {
      "$ref": "#/$defs/ReaderJob"
    },
    "proposal_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Id"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "result_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Hash"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "default": "queued",
      "enum": [
        "queued",
        "running",
        "completed",
        "blocked",
        "failed",
        "stale",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "job",
    "at"
  ],
  "title": "ReadState",
  "type": "object"
}
