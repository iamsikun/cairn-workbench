{
  "$defs": {
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "system",
                "developer",
                "user",
                "assistant",
                "tool"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "text"
      ],
      "title": "Segment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "enum": [
        "full_text",
        "excerpt",
        "abstract_only",
        "failed"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "images_inspected": {
      "default": false,
      "title": "Images Inspected",
      "type": "boolean"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "method_version": {
      "title": "Method Version",
      "type": "string"
    },
    "normalization": {
      "const": "none",
      "default": "none",
      "title": "Normalization",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "title": "Segments",
      "type": "array"
    },
    "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Source Id",
      "type": "string"
    },
    "tables_inspected": {
      "default": false,
      "title": "Tables Inspected",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "source_hash",
    "method",
    "method_version",
    "coverage",
    "segments"
  ],
  "title": "Extraction",
  "type": "object"
}
