{
  "additionalProperties": false,
  "properties": {
    "image": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image",
      "type": "string"
    },
    "model_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Hash",
      "type": "string"
    },
    "model_path": {
      "default": "/opt/cairn-models/model.gguf",
      "title": "Model Path",
      "type": "string"
    },
    "projection_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Projection Hash",
      "type": "string"
    },
    "projection_path": {
      "default": "/opt/cairn-models/mmproj.gguf",
      "title": "Projection Path",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "image",
    "model_hash",
    "projection_hash"
  ],
  "title": "RunnerConfig",
  "type": "object"
}
