{
  "additionalProperties": false,
  "properties": {
    "acknowledgements": {
      "items": {
        "type": "string"
      },
      "title": "Acknowledgements",
      "type": "array",
      "uniqueItems": true
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "owner_statement": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Owner Statement",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Hash",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workspace_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "proposal_id",
    "workspace_id",
    "proposal_hash",
    "policy_hash",
    "acknowledgements",
    "owner_statement",
    "at"
  ],
  "title": "Approval",
  "type": "object"
}
