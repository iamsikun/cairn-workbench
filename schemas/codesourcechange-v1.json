{
  "additionalProperties": false,
  "description": "Owner receipt for one replacement of the workspace's code source.",
  "properties": {
    "after_code_repository": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\x00]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "After Code Repository"
    },
    "after_code_roots": {
      "items": {
        "type": "string"
      },
      "title": "After Code Roots",
      "type": "array"
    },
    "after_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "After Hash",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "before_code_repository": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\x00]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Before Code Repository"
    },
    "before_code_roots": {
      "items": {
        "type": "string"
      },
      "title": "Before Code Roots",
      "type": "array"
    },
    "before_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Before Hash",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "owner_statement": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Owner Statement",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workspace_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "at",
    "before_code_roots",
    "before_code_repository",
    "after_code_roots",
    "after_code_repository",
    "before_hash",
    "after_hash",
    "owner_statement"
  ],
  "title": "CodeSourceChange",
  "type": "object"
}
