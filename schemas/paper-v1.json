{
  "$defs": {
    "FileLocation": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "default": "available",
          "enum": [
            "available",
            "unavailable",
            "missing"
          ],
          "title": "Availability",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "mtime_ns": {
          "title": "Mtime Ns",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "path",
        "content_hash",
        "size",
        "mtime_ns"
      ],
      "title": "FileLocation",
      "type": "object"
    },
    "MetadataEvidence": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "origin",
        "observed_at"
      ],
      "title": "MetadataEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstract"
    },
    "analysis_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "title": "Analysis Ids",
      "type": "array"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "external_ids": {
      "items": {
        "type": "string"
      },
      "title": "External Ids",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileLocation"
      },
      "title": "Files",
      "type": "array"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "issue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issue"
    },
    "journal_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Journal Ids",
      "type": "array"
    },
    "kind": {
      "const": "paper",
      "default": "paper",
      "title": "Kind",
      "type": "string"
    },
    "metadata_evidence": {
      "additionalProperties": {
        "$ref": "#/$defs/MetadataEvidence"
      },
      "title": "Metadata Evidence",
      "type": "object"
    },
    "note_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "title": "Note Ids",
      "type": "array"
    },
    "owner_fields": {
      "items": {
        "type": "string"
      },
      "title": "Owner Fields",
      "type": "array",
      "uniqueItems": true
    },
    "pages": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pages"
    },
    "priority": {
      "default": 0,
      "maximum": 3,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "published": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published"
    },
    "reading": {
      "default": "unknown",
      "enum": [
        "unknown",
        "unread",
        "queued",
        "reading",
        "skimmed",
        "read"
      ],
      "title": "Reading",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "topics": {
      "items": {
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    },
    "volume": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Volume"
    },
    "year": {
      "anyOf": [
        {
          "maximum": 9999,
          "minimum": 1000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    }
  },
  "required": [
    "journal_ids",
    "first_seen"
  ],
  "title": "Paper",
  "type": "object"
}
