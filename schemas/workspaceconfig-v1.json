{
  "additionalProperties": false,
  "properties": {
    "code_roots": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Code Roots",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "runtime_approval_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Approval Id"
    },
    "runtime_release_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Release Hash"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "worker_image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Image"
    }
  },
  "required": [
    "id",
    "synthetic",
    "code_roots"
  ],
  "title": "WorkspaceConfig",
  "type": "object"
}
