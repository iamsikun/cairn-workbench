{
  "$defs": {
    "PageClaim": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "reported_result",
            "inference",
            "hypothesis"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceCitation"
          },
          "maxItems": 40,
          "title": "Sources",
          "type": "array"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "title": "PageClaim",
      "type": "object"
    },
    "PageDraft": {
      "additionalProperties": false,
      "description": "A companion page; @key links refer to another page in this same proposal.",
      "properties": {
        "aliases": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 40,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aliases"
        },
        "base_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Hash"
        },
        "body_markdown": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Body Markdown",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/PageClaim"
          },
          "maxItems": 100,
          "title": "Claims",
          "type": "array"
        },
        "domain": {
          "default": "research",
          "enum": [
            "research",
            "finance",
            "life",
            "shared"
          ],
          "title": "Domain",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_-]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "title": "Limitations",
          "type": "array"
        },
        "new_type": {
          "default": "concept",
          "enum": [
            "concept",
            "project",
            "entity",
            "playbook",
            "decision"
          ],
          "title": "New Type",
          "type": "string"
        },
        "project_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Ids"
        },
        "related": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related"
        },
        "target": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "body_markdown",
        "key"
      ],
      "title": "PageDraft",
      "type": "object"
    },
    "SourceCitation": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator"
      ],
      "title": "SourceCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Hash"
    },
    "note_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Note Id",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageDraft"
      },
      "maxItems": 19,
      "title": "Pages",
      "type": "array"
    },
    "project_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,95}$",
        "type": "string"
      },
      "title": "Project Ids",
      "type": "array"
    },
    "related": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related"
    },
    "target": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    }
  },
  "required": [
    "note_id"
  ],
  "title": "NotebookPlan",
  "type": "object"
}
