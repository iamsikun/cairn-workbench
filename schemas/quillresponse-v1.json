{
  "$defs": {
    "QuillClaim": {
      "additionalProperties": false,
      "properties": {
        "evidence_keys": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "maxItems": 40,
          "title": "Evidence Keys",
          "type": "array"
        },
        "kind": {
          "enum": [
            "reported_result",
            "inference",
            "hypothesis"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quotations": {
          "items": {
            "$ref": "#/$defs/Quotation"
          },
          "maxItems": 20,
          "title": "Quotations",
          "type": "array"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "title": "QuillClaim",
      "type": "object"
    },
    "Quotation": {
      "additionalProperties": false,
      "properties": {
        "evidence_key": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Evidence Key",
          "type": "string"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "evidence_key",
        "text"
      ],
      "title": "Quotation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Quill returns prose and claims; Cairn formats the record itself.",
  "properties": {
    "body_markdown": {
      "maxLength": 200000,
      "minLength": 1,
      "title": "Body Markdown",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/QuillClaim"
      },
      "maxItems": 100,
      "title": "Claims",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 40,
      "title": "Limitations",
      "type": "array"
    },
    "packet_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Packet Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    }
  },
  "required": [
    "packet_id",
    "input_hash",
    "body_markdown"
  ],
  "title": "QuillResponse",
  "type": "object"
}
