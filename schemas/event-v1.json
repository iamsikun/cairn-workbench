{
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "attempt_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Hashes",
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Object Id",
      "type": "string"
    },
    "outcome": {
      "default": "succeeded",
      "enum": [
        "succeeded",
        "failed",
        "blocked"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "enum": [
        "captured",
        "extracted",
        "proposed",
        "validated",
        "approved",
        "applied",
        "indexed"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "id",
    "object_id",
    "attempt_id",
    "stage",
    "at"
  ],
  "title": "Event",
  "type": "object"
}
