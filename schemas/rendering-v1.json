{
  "additionalProperties": false,
  "properties": {
    "active": {
      "default": false,
      "title": "Active",
      "type": "boolean"
    },
    "checksum": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checksum"
    },
    "dependencies": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "default": {},
      "title": "Dependencies",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "output": {
      "title": "Output",
      "type": "string"
    },
    "pending_checksum": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pending Checksum"
    },
    "policy_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Hash"
    },
    "record_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Record Id",
      "type": "string"
    },
    "renderer": {
      "default": "",
      "title": "Renderer",
      "type": "string"
    },
    "route": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route"
    },
    "scope": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Scope",
      "type": "string"
    },
    "status": {
      "default": "inactive",
      "enum": [
        "current",
        "stale",
        "inactive"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "record_id",
    "scope",
    "output"
  ],
  "title": "Rendering",
  "type": "object"
}
