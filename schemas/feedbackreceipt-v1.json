{
  "$defs": {
    "Feedback": {
      "additionalProperties": false,
      "properties": {
        "bundle_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Hash",
          "type": "string"
        },
        "bundle_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/FeedbackEntry"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "bundle_id",
        "bundle_hash",
        "entries"
      ],
      "title": "Feedback",
      "type": "object"
    },
    "FeedbackEntry": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Comment",
          "type": "string"
        },
        "suggested_text": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Text"
        },
        "target_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "comment"
      ],
      "title": "FeedbackEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attribution": {
      "const": "Imported feedback; authorship and approval are not established",
      "default": "Imported feedback; authorship and approval are not established",
      "title": "Attribution",
      "type": "string"
    },
    "feedback": {
      "$ref": "#/$defs/Feedback"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "feedback",
    "source_id"
  ],
  "title": "FeedbackReceipt",
  "type": "object"
}
