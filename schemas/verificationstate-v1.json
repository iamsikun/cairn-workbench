{
  "$defs": {
    "VerificationFinding": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "kind": {
          "enum": [
            "numerical",
            "citation",
            "interpretation",
            "missing_evidence",
            "injection"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "severity": {
          "enum": [
            "minor",
            "serious"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "kind",
        "explanation"
      ],
      "title": "VerificationFinding",
      "type": "object"
    },
    "VerificationResult": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/VerificationFinding"
          },
          "maxItems": 40,
          "title": "Findings",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        },
        "packet_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Packet Hash",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "verdict": {
          "enum": [
            "supported",
            "concerns",
            "insufficient_evidence"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "packet_hash",
        "verdict"
      ],
      "title": "VerificationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Id",
      "type": "string"
    },
    "issue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issue"
    },
    "packet_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Packet Hash",
      "type": "string"
    },
    "provider": {
      "enum": [
        "codex",
        "claude"
      ],
      "title": "Provider",
      "type": "string"
    },
    "read_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Read Id",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Hash",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "status": {
      "default": "queued",
      "enum": [
        "queued",
        "completed",
        "blocked",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "read_id",
    "packet_hash",
    "result_hash",
    "source_hash",
    "provider",
    "reason",
    "at"
  ],
  "title": "VerificationState",
  "type": "object"
}
